<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pale_blue">

    <!-- CUSTOM NAVIGATION TOOLBAR -->
    <include layout="@layout/custom_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FULL WIDTH HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp">

                <!-- Background airplane image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home"
                    android:scaleType="centerCrop"
                    android:contentDescription="Airplane flying in the sky" />

                <!-- Darker overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_overlay" />

                <!-- Hero text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:text="Excess Baggage Fee Calculator"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Calculate your excess baggage charge easily."
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- CONTENT AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- INPUT CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- BAGGAGE WEIGHT -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▣  Baggage weight (kg)"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_field"
                        android:hint="Enter weight in kilograms"
                        android:inputType="numberDecimal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- TICKET CLASS -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="◆  Ticket class"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <RadioGroup
                        android:id="@+id/rgTicketClass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_field"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <RadioButton
                            android:id="@+id/rbEconomy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:checked="true"
                            android:minHeight="44dp"
                            android:gravity="center_vertical"
                            android:text="Economy (20 kg allowance)"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbBusiness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:minHeight="44dp"
                            android:gravity="center_vertical"
                            android:text="Business (40 kg allowance)"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp" />

                    </RadioGroup>

                    <!-- EXCESS BAGGAGE RATE -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="●  Excess baggage rate (RM/kg)"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/etRate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_field"
                        android:hint="Enter rate per kg"
                        android:inputType="numberDecimal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- HELPFUL NOTICE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_notice"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_info_circle"
                        android:gravity="center"
                        android:text="i"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Only baggage exceeding your ticket class allowance will be charged. An 8% service tax applies."
                        android:textColor="@color/navy"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <!-- CALCULATE BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/blue"
                    android:text="Calculate"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <!-- RESET BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/sky_blue"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <!-- FOOTER TEXT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="Your baggage fee estimate in just a few steps."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>